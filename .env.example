# Runtime profile for this fork
PANWATCH_PROFILE=xau

# AI configuration (this fork defaults to Atria)
AI_BASE_URL=https://api.atria-asi.ai/v1
AI_API_KEY=your_atria_key_here
# ATRIA_API_KEY can be used instead of AI_API_KEY.
AI_MODEL=Atria-Dawn-Preview

# 助手上下文（也可在“小助手配置”中覆盖）
# CONTEXT_COMPRESSION_MODEL_ID=1
# CONTEXT_COMPRESSION_TEMPERATURE=0.1
# CONTEXT_SUMMARY_MAX_TOKENS=800
# CONTEXT_MAX_TOKENS=12000
# CONTEXT_SOFT_LIMIT_TOKENS=8400
# CONTEXT_HARD_LIMIT_TOKENS=10200
# CONTEXT_KEEP_RECENT_MESSAGES=8

# Ahmed ToolBox MCP (optional)
# Leave URL empty to keep external research disabled.
# AHMED_TOOLBOX_URL=http://127.0.0.1:8765/mcp
# AHMED_TOOLBOX_TOKEN=replace_with_secret
# AHMED_TOOLBOX_TIMEOUT_SECONDS=5

# 通知配置 - Telegram
NOTIFY_TELEGRAM_BOT_TOKEN=your_bot_token
NOTIFY_TELEGRAM_CHAT_ID=your_chat_id

# 代理配置（国内访问 Telegram 可能需要）
# HTTP_PROXY=http://127.0.0.1:7890

# SSL 企业证书（Zscaler 等企业代理环境需要，留空则不启用）
# CA_CERT_FILE=/path/to/your/enterprise-cert.crt

# 调度配置（cron 表达式：分 时 日 月 周）
DAILY_REPORT_CRON=30 15 * * 1-5


# XAU weekly paper league (paper-only; never live execution)
XAU_PAPER_ENABLED=true
XAU_PAPER_INITIAL_CAPITAL=10000
XAU_PAPER_RISK_PCT=0.01
XAU_PAPER_REWARD_RISK=2.0
XAU_PAPER_MAX_LEVERAGE=1.0
XAU_PAPER_SCAN_SECONDS=60
XAU_PAPER_TIMEZONE=Asia/Baghdad
# Optional but recommended in hosted deployments. Keep this secret.
# XAU_PAPER_DATABASE_URL=postgresql://...
